# NVS 环境变量示例（复制为 .env 使用；首次启动也会自动生成同结构的 .env）
# 说明：留空的密钥项启动时会自动生成/派生（JWT 密钥落盘 data/.jwt_secret），生产环境请显式填写。
# 该文件与 server/config/config.go 的 defaultEnvTemplate 保持一致，改这里请同步改那里。

# ==================== 数据库 ====================
# DB_DRIVER: sqlite (默认，零配置) | mysql (需额外安装 MySQL)
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nvs_user
DB_PASSWORD=
DB_NAME=nvs
DB_ROOT_PASSWORD=

# ==================== Redis (SQLite模式下不需要) ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==================== JWT ====================
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# ==================== 文件存储 ====================
NOVEL_DATA_DIR=./data/novels
UPLOAD_DIR=./data/uploads

# ==================== 用户自定义内容 ====================
USER_FRAME_DIR=./data/userframe
USER_HTML_DIR=./data/userhtml

# ==================== 服务端口与网络 ====================
SERVER_PORT=8080

# 绑定地址：IPv4 地址（默认 0.0.0.0 监听所有 IPv4 网卡）
BIND_IPV4=0.0.0.0

# 绑定地址：IPv6 地址（默认 :: 监听所有 IPv6 网卡）
BIND_IPV6=::

# 是否启用 IPv6 双栈监听（true/false）
# 开启后服务器同时监听 IPv4 和 IPv6 地址
ENABLE_IPV6=false

# ==================== 国密（SM）双轨密码（可选模块，默认国际轨） ====================
# NVS_CRYPTO_TRACK: intl（默认，标准 RSA/ECC+AES，零国密依赖）| gm（纯国密 SM2/SM3/SM4+TLCP）| dual（双轨自适应协商）
# 责任边界：框架不代做等保/密评；是否启用及合规责任由站长自行承担（见 docs/gm-mapping.md）
NVS_CRYPTO_TRACK=intl

# 国际轨证书（track=intl 或 dual 时生效；都不配 = 纯 HTTP，适合反向代理终止 TLS 的部署）
NVS_CRYPTO_INTL_CERT=
NVS_CRYPTO_INTL_KEY=

# 国密实现路径（track=gm/dual 必填）：tongsuo（推荐，CGO 官方绑定，需 Tongsuo C 库）| purego（纯 Go，无 CGO）
NVS_CRYPTO_GM_PROVIDER=

# 国密双证书四件套（track=gm/dual 必填；TLCP 要求签名+加密两套证书）
NVS_CRYPTO_SM_SIGN_CERT=
NVS_CRYPTO_SM_SIGN_KEY=
NVS_CRYPTO_SM_ENC_CERT=
NVS_CRYPTO_SM_ENC_KEY=

# 禁用 TLS 会话复用（默认 false）
NVS_CRYPTO_SESSION_TICKETS_DISABLED=false

# 握手记录 JSONL 输出路径（留空 = 关闭；记录协议/套件/SNI，不含业务数据）
NVS_TLS_HANDSHAKE_LOG=

# 本机 IPv4 地址（自动检测，用于对外展示/联邦互通）
LOCAL_IPV4=

# 本机 IPv6 地址（自动检测，用于对外展示/联邦互通）
LOCAL_IPV6=

# ==================== SMTP 邮件配置（用于邮箱验证码） ====================
# 支持 QQ邮箱/Gmail/163 等 SMTP 服务
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=
SMTP_FROM=your-email@qq.com

# ==================== 平台配置 ====================
PLATFORM_FEE_RATE=0.10
SITE_NAME=NVS 类型文学平台
# 邮箱验证功能开关（true/false）
EMAIL_VERIFY_ENABLED=false
# 滑块验证码开关（true/false）
CAPTCHA_ENABLED=false

# ==================== 安全 / 反向代理 ====================
# 信任的反向代理地址（逗号分隔的 IP 或 CIDR，如 127.0.0.1,10.0.0.0/8）。
# 留空 = 不信任任何代理，客户端 IP 取真实 TCP 对端地址（默认，可防 X-Forwarded-For 伪造越权）。
# 仅当部署在反向代理（如 nginx）之后且需记录真实客户端 IP 时，才填写代理地址。
TRUSTED_PROXIES=

# JWT Cookie 是否强制 Secure（仅 HTTPS 下传输，true/false，默认 false）。
# 生产环境启用 HTTPS 后务必设为 true，防止令牌在明文 HTTP 中被截获（安全审计 L3）。
COOKIE_SECURE=false

# 站点路径前缀（URL_PREFIX，默认留空=挂在域名根）。
# 用于反向代理场景：如 nginx 将 /go-nvs/ 前缀转发到本站，则填 /go-nvs，
# 访问 :8088/go-nvs/login 即可正常使用（自动剥离前缀 + 前端路由/API 自适应）。
# 注意：必须以 / 开头且不带尾斜杠，如 /go-nvs；留空 = 无前缀（默认）。
URL_PREFIX=

# 建站向导 / 安装接口是否仅允许本机(localhost)访问（true/false，默认 true）。
# 防止反向代理/公网直连越权进入安装向导；如需从局域网远程初始化可设为 false。
SETUP_LOCAL_ONLY=true

# ==================== 短信网关（手机号登录/验证码，可插拔） ====================
# SMS_GATEWAY: log=开发网关（验证码写入服务日志，不真实发送）；http=通用 HTTP 网关。
# http 网关约定：POST JSON {"phone","code","sign_name","template_code"} 到 SMS_HTTP_URL，
# 请求头 Authorization: Bearer <SMS_HTTP_TOKEN>，2xx 视为发送成功。
# 适配自建短信网关或云厂商 Webhook（阿里云/腾讯云可用其 API 网关封装为统一 Webhook）。
SMS_GATEWAY=log
# SMS_GATEWAY=http 时必填：
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# 短信签名（需在短信平台报备）与模板 Code（模板内容须含验证码占位符）
SMS_SIGN_NAME=星海文学
SMS_TEMPLATE_CODE=
# 网关超时（秒）
SMS_TIMEOUT_SEC=5

# ==================== 实名信息加密（公安部令第176号合规） ====================
# 实名姓名/身份证号以 AES-256-GCM 加密存储。此项为 hex 或 base64 编码的 32 字节密钥；
# 留空则自动由 JWT_SECRET 派生（重启不丢失，但轮换 JWT_SECRET 会导致历史数据不可解密，
# 生产环境强烈建议显式配置独立密钥）。
REAL_NAME_ENC_KEY=

# ==================== 微信开放平台网页扫码登录 ====================
# 在微信开放平台（open.weixin.qq.com）创建「网站应用」获得 AppID/AppSecret，
# 回调域名须在平台登记且与 WECHAT_CALLBACK 的域名一致（含路径前缀）。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 完整回调地址，如 https://example.com/go-nvs/api/auth/wechat/callback
WECHAT_CALLBACK=

# ==================== 日志敏感信息脱敏（公安部令第176号合规） ====================
# 访问日志中的 Token / 密码 / 敏感字段脱敏开关：
# true  = 生产模式：自动脱敏 Cookie/Authorization 令牌、body/query 敏感字段，合规安全
# false = 开发模式：保留原始数据，方便调试
LOG_REDACT_SENSITIVE=false

# 自定义脱敏掩码字符（默认 ***REDACTED***；密码类字段固定使用 ******）
LOG_REDACT_MASK="***REDACTED***"

# 自定义敏感字段列表（逗号分隔，默认 password,token,authorization,cookie,secret,apikey）
LOG_SENSITIVE_FIELDS="password,token,authorization,cookie,secret,apikey"
