# 环境变量
.env

# 运行时数据
data/

# ⚠️ 例外：ip2region 离线库必须入库。
# //go:embed 是编译期读文件，CI / 新克隆拿不到它就无法构建
# （报 pattern data/ip2region_v4.xdb: no matching files found）。
# 注意顺序：先把被 data/ 排除的目录本身放回来，git 才会进去；只写文件级 ! 是无效的。
!server/ipgeo/data/
!server/ipgeo/data/*.xdb

# Go
server/tmp/
server/*.exe

# Node
web/node_modules/
web/dist/

# Build artifacts
dist/
server/dist/
# 构建时 mv 备份的旧产物目录（如 dist_old/、server/dist_old/）
dist_old*/
dist_prev*/
dist_bak*/
server/dist_old*/
server/dist_prev*/
nvs-server.exe
*.exe
# 跨平台发布产物（交叉编译输出，体积大，不入库）
release/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
*.swp
~$*

# Vite 运行时临时文件
web/vite.config.ts.timestamp-*.mjs
web/*.timestamp-*.mjs

# WorkBuddy 项目本地数据（记忆/日志）
.workbuddy/

# 日志
*.log
logs/



# 测试运行产物（go test 在 handlers 包目录生成）
server/handlers/authors/
server/handlers/log/
server/middleware/log/
server/log/
server/data/
server.pid

# 冒烟测试临时目录（server/smoke_test.sh 运行产物）
.smoke_*/

# 冒烟/探测脚本与截图（本地 Playwright 验证产物，勿入库）
/web/*.mjs
/web/*.png
